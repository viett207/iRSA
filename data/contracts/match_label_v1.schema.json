{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recruitment-agent/match-label-v1",
  "title": "Recruiter-reviewable job-candidate match label",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pair_id",
    "candidate_profile_id",
    "candidate_data_origin",
    "candidate_language",
    "candidate_headline_snapshot",
    "candidate_experience_years",
    "candidate_skills_snapshot",
    "job_record_id",
    "job_source_name",
    "job_language",
    "job_title_snapshot",
    "job_description_excerpt",
    "pairing_method",
    "overlapping_skills",
    "heuristic_skill_overlap",
    "suggested_bucket",
    "label_status",
    "recruiter_label",
    "reviewer_id",
    "reviewed_at",
    "reviewer_notes",
    "input_lineage",
    "created_at"
  ],
  "properties": {
    "pair_id": {"type": "string", "pattern": "^pair_[a-f0-9]{24}$"},
    "candidate_profile_id": {"type": "string", "pattern": "^candidate_[a-z0-9_]+$"},
    "candidate_data_origin": {"type": "string", "enum": ["synthetic", "consented_partner", "consented_user"]},
    "candidate_language": {"type": "string", "enum": ["vi", "en", "mixed"]},
    "candidate_headline_snapshot": {"type": "string", "minLength": 1},
    "candidate_experience_years": {"type": "number", "minimum": 0},
    "candidate_skills_snapshot": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "job_record_id": {"type": "string", "minLength": 1},
    "job_source_name": {"type": "string", "minLength": 1},
    "job_language": {"type": "string", "enum": ["vi", "en", "mixed"]},
    "job_title_snapshot": {"type": "string", "minLength": 1},
    "job_description_excerpt": {"type": "string", "minLength": 1, "maxLength": 1200},
    "pairing_method": {"type": "string", "const": "deterministic_skill_overlap_v1"},
    "overlapping_skills": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "heuristic_skill_overlap": {"type": "number", "minimum": 0, "maximum": 1},
    "suggested_bucket": {"type": "string", "enum": ["likely_match", "uncertain_match", "likely_not_match"]},
    "label_status": {"type": "string", "enum": ["pending_recruiter_review", "reviewed", "rejected"]},
    "recruiter_label": {"type": ["string", "null"], "enum": ["strong_match", "partial_match", "not_match", "insufficient_evidence", null]},
    "reviewer_id": {"type": ["string", "null"]},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "reviewer_notes": {"type": ["string", "null"]},
    "input_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobs_path", "jobs_sha256", "candidates_path", "candidates_sha256"],
      "properties": {
        "jobs_path": {"type": "string", "pattern": "^data/silver/jobs/"},
        "jobs_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "candidates_path": {"type": "string", "pattern": "^data/silver/candidates/"},
        "candidates_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
