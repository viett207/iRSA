{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recruitment-agent/development-benchmark-manifest-v1",
  "title": "Immutable development benchmark manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_name", "manifest_version", "created_at", "usage_scope", "ground_truth_status", "assets", "source_lineage", "limitations"],
  "properties": {
    "dataset_name": {"type": "string", "const": "p164_development_benchmark_v1"},
    "manifest_version": {"type": "string", "const": "1.0.0"},
    "created_at": {"type": "string", "format": "date-time"},
    "usage_scope": {"type": "string", "const": "local_development_and_offline_pipeline_evaluation_only"},
    "ground_truth_status": {"type": "string", "const": "automated_drafts_not_human_ground_truth"},
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobs", "candidates", "match_review_queue", "automated_job_prechecks", "automated_match_label_drafts"],
      "properties": {
        "jobs": {"$ref": "#/$defs/asset"},
        "candidates": {"$ref": "#/$defs/asset"},
        "match_review_queue": {"$ref": "#/$defs/asset"},
        "automated_job_prechecks": {"$ref": "#/$defs/asset"},
        "automated_match_label_drafts": {"$ref": "#/$defs/asset"}
      }
    },
    "source_lineage": {"type": "object", "additionalProperties": true},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "source_path", "record_count", "sha256", "byte_identical_to_source"],
      "properties": {
        "path": {"type": "string", "pattern": "^data/experimental/"},
        "source_path": {"type": "string", "pattern": "^data/"},
        "record_count": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "byte_identical_to_source": {"type": "boolean", "const": true}
      }
    }
  }
}
