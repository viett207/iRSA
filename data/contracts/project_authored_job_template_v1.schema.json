{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recruitment-agent/project-authored-job-template-v1",
  "title": "Bilingual project-authored job benchmark record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id", "schema_version", "data_origin", "usage_scope", "language",
    "title_original", "description_original", "job_family", "experience_level",
    "experience_years_min", "skills_canonical", "is_live_job_posting",
    "company_name", "location_original", "work_mode", "onet_reference",
    "created_at", "quality_status", "quality_flags"
  ],
  "properties": {
    "record_id": {"type": "string", "pattern": "^job_benchmark_[a-z0-9_]+$"},
    "schema_version": {"type": "string", "const": "1.0.0"},
    "data_origin": {"type": "string", "const": "project_authored_from_onet"},
    "usage_scope": {"type": "string", "const": "development_evaluation_only"},
    "language": {"type": "string", "enum": ["vi", "en"]},
    "title_original": {"type": "string", "minLength": 1},
    "description_original": {"type": "string", "minLength": 250},
    "job_family": {"type": "string", "minLength": 1},
    "experience_level": {"type": "string", "enum": ["entry", "junior", "mid", "senior", "lead"]},
    "experience_years_min": {"type": "number", "minimum": 0},
    "skills_canonical": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "is_live_job_posting": {"type": "boolean", "const": false},
    "company_name": {"type": "null"},
    "location_original": {"type": "string", "const": "Fictional benchmark location"},
    "work_mode": {"type": "string", "enum": ["onsite", "hybrid", "remote"]},
    "onet_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occupation_code", "occupation_title", "source_dataset", "source_url", "license", "attribution", "source_artifact_path", "source_artifact_sha256"],
      "properties": {
        "occupation_code": {"type": "string", "pattern": "^[0-9]{2}-[0-9]{4}\\.[0-9]{2}$"},
        "occupation_title": {"type": "string", "minLength": 1},
        "source_dataset": {"type": "string", "const": "O*NET 30.3 Database"},
        "source_url": {"type": "string", "const": "https://www.onetcenter.org/database.html"},
        "license": {"type": "string", "const": "CC-BY-4.0"},
        "attribution": {"type": "string", "minLength": 1},
        "source_artifact_path": {"type": "string", "const": "data/raw/taxonomies/onet_30_3.zip"},
        "source_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "quality_status": {"type": "string", "const": "pending_human_review"},
    "quality_flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
