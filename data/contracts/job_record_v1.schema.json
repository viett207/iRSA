{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recruitment-agent/job-record-v1",
  "title": "Bilingual recruitment job record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "source_name",
    "source_url",
    "source_job_id",
    "crawled_at",
    "language",
    "title_original",
    "description_original",
    "raw_payload_path",
    "raw_payload_sha256",
    "collection_policy_id",
    "quality_status"
  ],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "source_name": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "source_job_id": {"type": "string", "minLength": 1},
    "crawled_at": {"type": "string", "format": "date-time"},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"},
    "language": {"type": "string", "enum": ["vi", "en", "mixed"]},
    "title_original": {"type": "string", "minLength": 1},
    "description_original": {"type": "string", "minLength": 1},
    "company_name": {"type": ["string", "null"]},
    "location_original": {"type": ["string", "null"]},
    "skills_canonical": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "salary_min": {"type": ["number", "null"], "minimum": 0},
    "salary_max": {"type": ["number", "null"], "minimum": 0},
    "currency": {"type": ["string", "null"]},
    "raw_payload_path": {"type": "string", "pattern": "^data/raw/"},
    "raw_payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "collection_policy_id": {"type": "string", "minLength": 1},
    "quality_status": {"type": "string", "enum": ["valid", "quarantine", "needs_review"]},
    "quality_flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
