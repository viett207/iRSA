# P-164 local environment
# Copy to .env and replace placeholder secrets. Never commit .env.

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:4200,http://localhost:4300

# PostgreSQL (Supabase Cloud)
POSTGRES_USER=postgres.your_project_ref
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=postgres
DATABASE_URL=postgresql+asyncpg://postgres.your_project_ref:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Redis (Upstash Cloud)
REDIS_URL=redis://default:your_token@your_instance.upstash.io:6379

# Supabase Storage (Cloud S3-Compatible)
MINIO_ENDPOINT=your_project_ref.storage.supabase.co/storage/v1/s3
MINIO_ACCESS_KEY=your_supabase_s3_access_key
MINIO_SECRET_KEY=your_supabase_s3_secret_key
MINIO_BUCKET=resumes
MINIO_REGION=ap-south-1
MINIO_SECURE=true
MINIO_PUBLIC_URL=https://your_project_ref.supabase.co/storage/v1/object/public/resumes

# Authentication
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_HTTPONLY=true
COOKIE_DOMAIN=

# Frontends
FRONTEND_ADMIN_URL=http://localhost:4200
FRONTEND_PORTAL_URL=http://localhost:4300

# LLM and Agent
OPENAI_API_KEY=
GEMINI_API_KEY=
# Declare multiple Gemini keys (comma-separated) for automatic key rotation on token exhaustion
GEMINI_API_KEYS=key1,key2,key3
DEEPSEEK_API_KEY=
MODEL_NAME=gemini-1.5-flash
LLM_TEMPERATURE=0.2
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Vector store
CHROMA_PERSIST_DIR=./data/chroma

# LangSmith tracing (optional)
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=p-164-screening-agent
LANGCHAIN_TRACING_V2=false

# Email (optional for local development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@irsa.local
EMAIL_FROM_NAME=P-164 Recruitment

# Course AI usage logging (optional; use the key assigned to your team)
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log
