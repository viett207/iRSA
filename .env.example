# P-164 local environment
# Copy to .env and replace placeholder secrets. Never commit .env.

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:4200,http://localhost:4300

# PostgreSQL (local)
POSTGRES_USER=irsa
POSTGRES_PASSWORD=irsa
POSTGRES_DB=irsa
DATABASE_URL=postgresql+asyncpg://irsa:irsa@localhost:5432/irsa

# Redis (local)
REDIS_URL=redis://localhost:6379/0

# MinIO (local)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=resumes
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://localhost:9000

# Authentication
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_HTTPONLY=true
COOKIE_DOMAIN=

# Frontends
FRONTEND_ADMIN_URL=http://localhost:4200
FRONTEND_PORTAL_URL=http://localhost:4300

# LLM and Agent
OPENAI_API_KEY=
GEMINI_API_KEY=
# Declare multiple Gemini keys (comma-separated) for automatic key rotation on token exhaustion
GEMINI_API_KEYS=key1,key2,key3
DEEPSEEK_API_KEY=
MODEL_NAME=gemini-1.5-flash
LLM_TEMPERATURE=0.2
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Vector store
CHROMA_PERSIST_DIR=./data/chroma

# LangSmith tracing (optional)
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=p-164-screening-agent
LANGCHAIN_TRACING_V2=false

# Email (optional for local development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@irsa.local
EMAIL_FROM_NAME=P-164 Recruitment

# Course AI usage logging (optional; use the key assigned to your team)
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log
